{
    "cucumberautocomplete.steps": [
        "src/test/java/com/matrix/steps/*.java"
    ],
    "cucumberautocomplete.syncfeatures": "scenarios/**/*.feature",
    "cucumberautocomplete.strictGherkinCompletion": false,
    "cucumberautocomplete.customParameters": [
        {
            "parameter": "\\{\\d+\\}",
            "value": ".*?",
            "isRegex": true,
            "flags": "g"
        }
    ],
    "cucumberautocomplete.gherkinDefinitionPart": "(@QAFTestStep\\(description\\s*=\\s*)",
    "cucumberautocomplete.stepRegExSymbol": "\"",
    "java.compile.nullAnalysis.mode": "automatic"
}
